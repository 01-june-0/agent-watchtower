{
  "name": "agent-watchtower",
  "version": "0.1.1",
  "description": "A local, read-only dashboard that shows what your Claude Code sessions, subagents and advisor are doing right now.",
  "type": "module",
  "bin": {
    "agent-watchtower": "bin/agent-watchtower.mjs"
  },
  "files": [
